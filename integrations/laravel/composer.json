{
    "name": "ivopdf/laravel",
    "description": "Laravel integration for IvoPDF: a pure-PHP HTML/CSS to PDF engine with Flexbox, CSS Grid and Cyrillic support. Drop-in friendly for barryvdh/laravel-dompdf.",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/ivoapostolov/ivopdf",
    "keywords": ["laravel", "pdf", "html-to-pdf", "ivopdf", "dompdf", "flexbox", "css-grid"],
    "authors": [{"name": "Ivo Apostolov", "homepage": "https://github.com/ivoapostolov"}],
    "require": {
        "php": ">=8.1",
        "ivopdf/ivopdf": "^1.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {"IvoPdf\\Laravel\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"IvoPdf\\Laravel\\Tests\\": "tests/"}
    },
    "repositories": [
        {
            "type": "path",
            "url": "../dev-core",
            "options": {"symlink": false, "versions": {"ivopdf/ivopdf": "1.0.0"}}
        }
    ],
    "extra": {
        "laravel": {
            "providers": ["IvoPdf\\Laravel\\IvoPdfServiceProvider"],
            "aliases": {
                "Pdf": "IvoPdf\\Laravel\\Facades\\Pdf",
                "PDF": "IvoPdf\\Laravel\\Facades\\Pdf"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
